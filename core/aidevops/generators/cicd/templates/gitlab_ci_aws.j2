stages:
  - test
  - build
  - deploy

variables:
  ECR_REGISTRY: ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
  IMAGE_NAME: ${ECR_REGISTRY}/{{ app_name }}
  IMAGE_TAG: $CI_COMMIT_SHA

{% if language == 'java' or language == 'kotlin' %}
.java_setup: &java_setup
  image: eclipse-temurin:{{ language_version }}-jdk
  before_script:
{% if build_tool == 'gradle' %}
    - chmod +x gradlew 2>/dev/null || true
{% else %}
    - chmod +x mvnw 2>/dev/null || true
{% endif %}

test:
  <<: *java_setup
  stage: test
  script:
    - {{ test_command }}
  cache:
    paths:
{% if build_tool == 'gradle' %}
      - .gradle/
      - build/
{% else %}
      - .m2/repository/
{% endif %}
  artifacts:
    reports:
      junit:
{% if build_tool == 'gradle' %}
        - build/test-results/test/*.xml
{% else %}
        - target/surefire-reports/*.xml
{% endif %}

build:
  <<: *java_setup
  stage: build
  script:
    - {{ build_command }}
  artifacts:
    paths:
{% if build_tool == 'gradle' %}
      - build/libs/*.jar
{% else %}
      - target/*.jar
{% endif %}
    expire_in: 1 hour

{% elif language in ('javascript', 'typescript') %}
test:
  stage: test
  image: node:{{ language_version }}-alpine
  script:
    - {{ pkg_install_command }}
    - {{ test_command }}
  cache:
    paths:
      - node_modules/

build:
  stage: build
  image: node:{{ language_version }}-alpine
  script:
    - {{ pkg_install_command }}
    - {{ build_command }}
  artifacts:
    paths:
      - dist/
    expire_in: 1 hour

{% elif language == 'python' %}
test:
  stage: test
  image: python:{{ language_version }}-slim
  script:
    - {{ pkg_install_command }}
    - {{ test_command }}
  cache:
    paths:
      - .pip_cache/

build:
  stage: build
  image: python:{{ language_version }}-slim
  script:
    - echo "Python build stage"

{% endif %}
build-docker:
  stage: build
  image: docker:24
  services:
    - docker:24-dind
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  before_script:
    - apk add --no-cache aws-cli
    - aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY
  script:
    - docker build -t $IMAGE_NAME:$IMAGE_TAG -t $IMAGE_NAME:latest .
    - docker push $IMAGE_NAME:$IMAGE_TAG
    - docker push $IMAGE_NAME:latest
{% if language in ('java', 'kotlin', 'javascript', 'typescript', 'python') %}
  needs:
    - build
{% endif %}

deploy:
  stage: deploy
  image: alpine:3.19
  before_script:
    - apk add --no-cache openssh-client aws-cli
    - eval $(ssh-agent -s)
    - echo "$SERVER_SSH_KEY" | tr -d '\r' | ssh-add -
    - mkdir -p ~/.ssh && chmod 700 ~/.ssh
    - ssh-keyscan -H $SERVER_HOST >> ~/.ssh/known_hosts
  script:
    - |
      ssh $SERVER_USER@$SERVER_HOST "
        set -e
        aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY
        docker pull $IMAGE_NAME:$IMAGE_TAG
        IMAGE_TAG=$IMAGE_TAG docker-compose up -d
        sleep 15
        curl -sf http://localhost:{{ port }}/{% if framework == 'springboot' %}actuator/health{% else %}health{% endif %}
        echo 배포완료
      "
  environment:
    name: production
    url: http://$SERVER_HOST:{{ port }}
  only:
    - {{ branch }}
  needs:
    - build-docker
